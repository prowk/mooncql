///|
test "Python exact timestamp and nanosecond reference" {
  assert_eq(
    @types.CqlTimestamp::from_millis(-9223372036854775808L).to_string(),
    "-292275055-05-16T16:47:04.192000000Z",
  )
  assert_eq(
    @types.CqlTimestamp::from_string("-292275055-05-16T16:47:04.192000000Z").millis(),
    -9223372036854775808L,
  )
  assert_eq(
    @types.CqlTimestamp::from_millis(9223372036854775807L).to_string(),
    "+292278994-08-17T07:12:55.807000000Z",
  )
  assert_eq(
    @types.CqlTimestamp::from_string("+292278994-08-17T07:12:55.807000000Z").millis(),
    9223372036854775807L,
  )
  assert_eq(
    @types.CqlTimestamp::from_millis(0L).to_string(),
    "1970-01-01T00:00:00Z",
  )
  assert_eq(
    @types.CqlTimestamp::from_string("1970-01-01T00:00:00Z").millis(),
    0L,
  )
  assert_eq(
    @types.CqlTimestamp::from_millis(-1L).to_string(),
    "1969-12-31T23:59:59.999000000Z",
  )
  assert_eq(
    @types.CqlTimestamp::from_string("1969-12-31T23:59:59.999000000Z").millis(),
    -1L,
  )
  assert_eq(
    @types.CqlTimestamp::from_millis(1L).to_string(),
    "1970-01-01T00:00:00.001000000Z",
  )
  assert_eq(
    @types.CqlTimestamp::from_string("1970-01-01T00:00:00.001000000Z").millis(),
    1L,
  )
