///|
test "Python UUID and decimal coefficient scale reference" {
  assert_eq(
    @types.CqlUuid::from_string("D689D417-23A6-83DD-96FC-6D9FCD3D45D3").to_bytes(),
    b"\xd6\x89\xd4\x17\x23\xa6\x83\xdd\x96\xfc\x6d\x9f\xcd\x3d\x45\xd3",
  )
  assert_eq(
    @types.CqlUuid::from_bytes(
      b"\xd6\x89\xd4\x17\x23\xa6\x83\xdd\x96\xfc\x6d\x9f\xcd\x3d\x45\xd3",
    ).to_string(),
    "d689d417-23a6-83dd-96fc-6d9fcd3d45d3",
  )
  assert_eq(
    @types.CqlUuid::from_string("8C0BF906-B15C-47DD-382A-F1BC88DA9824").to_bytes(),
    b"\x8c\x0b\xf9\x06\xb1\x5c\x47\xdd\x38\x2a\xf1\xbc\x88\xda\x98\x24",
  )
  assert_eq(
    @types.CqlUuid::from_bytes(
      b"\x8c\x0b\xf9\x06\xb1\x5c\x47\xdd\x38\x2a\xf1\xbc\x88\xda\x98\x24",
    ).to_string(),
    "8c0bf906-b15c-47dd-382a-f1bc88da9824",
  )
  assert_eq(
    @types.CqlUuid::from_string("F31458DE-CC01-9743-D6C7-B41F357C3B98").to_bytes(),
    b"\xf3\x14\x58\xde\xcc\x01\x97\x43\xd6\xc7\xb4\x1f\x35\x7c\x3b\x98",
  )
  assert_eq(
    @types.CqlUuid::from_bytes(
      b"\xf3\x14\x58\xde\xcc\x01\x97\x43\xd6\xc7\xb4\x1f\x35\x7c\x3b\x98",
    ).to_string(),
    "f31458de-cc01-9743-d6c7-b41f357c3b98",
  )
  assert_eq(
    @types.CqlUuid::from_string("6DBFD43B-FAC5-AAEB-2A28-8B1500F9C60A").to_bytes(),
    b"\x6d\xbf\xd4\x3b\xfa\xc5\xaa\xeb\x2a\x28\x8b\x15\x00\xf9\xc6\x0a",
