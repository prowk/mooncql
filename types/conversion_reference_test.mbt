  assert_eq(
    @types.CqlUuid::from_string("DBD221D0-0DC2-564A-95DE-E93515B3E83B").to_bytes(),
    b"\xdb\xd2\x21\xd0\x0d\xc2\x56\x4a\x95\xde\xe9\x35\x15\xb3\xe8\x3b",
  )
  assert_eq(
    @types.CqlUuid::from_bytes(
      b"\xdb\xd2\x21\xd0\x0d\xc2\x56\x4a\x95\xde\xe9\x35\x15\xb3\xe8\x3b",
    ).to_string(),
    "dbd221d0-0dc2-564a-95de-e93515b3e83b",
  )
  assert_eq(
    @types.CqlUuid::from_string("CEF3885E-9D39-D551-0B97-66B646A7B2A3").to_bytes(),
    b"\xce\xf3\x88\x5e\x9d\x39\xd5\x51\x0b\x97\x66\xb6\x46\xa7\xb2\xa3",
  )
