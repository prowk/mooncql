    @types.CqlTime::from_string("10:20:13.343873257").nanos(),
    37213343873257L,
  )
  assert_eq(
    @types.CqlTime::from_nanos(6294092802329L).to_string(),
    "01:44:54.092802329",
  )
  assert_eq(
    @types.CqlTime::from_string("01:44:54.092802329").nanos(),
    6294092802329L,
  )
  assert_eq(
    @types.CqlTime::from_nanos(4132959532467L).to_string(),
    "01:08:52.959532467",
  )
  assert_eq(
    @types.CqlTime::from_string("01:08:52.959532467").nanos(),
    4132959532467L,
  )
  assert_eq(
    @types.CqlTime::from_nanos(21744542465202L).to_string(),
    "06:02:24.542465202",
  )
  assert_eq(
    @types.CqlTime::from_string("06:02:24.542465202").nanos(),
    21744542465202L,
  )
  assert_eq(
    @types.CqlTime::from_nanos(62590987900877L).to_string(),
    "17:23:10.987900877",
  )
  assert_eq(
    @types.CqlTime::from_string("17:23:10.987900877").nanos(),
    62590987900877L,
  )
  assert_eq(
    @types.CqlTime::from_nanos(55191709381667L).to_string(),
    "15:19:51.709381667",
  )
  assert_eq(
    @types.CqlTime::from_string("15:19:51.709381667").nanos(),
    55191709381667L,
  )
}

///|
test "Python arbitrary precision signed integer reference" {
  assert_eq(@types.CqlVarInt::from_decimal_string("0").to_bytes(), b"\x00")
  assert_eq(@types.CqlVarInt::from_bytes(b"\x00").to_decimal_string(), "0")
  assert_eq(@types.CqlVarInt::from_decimal_string("1").to_bytes(), b"\x01")
  assert_eq(@types.CqlVarInt::from_bytes(b"\x01").to_decimal_string(), "1")
  assert_eq(@types.CqlVarInt::from_decimal_string("-1").to_bytes(), b"\xff")
  assert_eq(@types.CqlVarInt::from_bytes(b"\xff").to_decimal_string(), "-1")
  assert_eq(@types.CqlVarInt::from_decimal_string("127").to_bytes(), b"\x7f")
  assert_eq(@types.CqlVarInt::from_bytes(b"\x7f").to_decimal_string(), "127")
  assert_eq(
    @types.CqlVarInt::from_decimal_string("128").to_bytes(),
    b"\x00\x80",
  )
  assert_eq(
    @types.CqlVarInt::from_bytes(b"\x00\x80").to_decimal_string(),
    "128",
  )
  assert_eq(@types.CqlVarInt::from_decimal_string("-128").to_bytes(), b"\x80")
  assert_eq(@types.CqlVarInt::from_bytes(b"\x80").to_decimal_string(), "-128")
  assert_eq(
    @types.CqlVarInt::from_decimal_string("-129").to_bytes(),
    b"\xff\x7f",
  )
  assert_eq(
    @types.CqlVarInt::from_bytes(b"\xff\x7f").to_decimal_string(),
    "-129",
  )
  assert_eq(
    @types.CqlVarInt::from_decimal_string("255").to_bytes(),
    b"\x00\xff",
  )
  assert_eq(
    @types.CqlVarInt::from_bytes(b"\x00\xff").to_decimal_string(),
    "255",
  )
  assert_eq(
    @types.CqlVarInt::from_decimal_string("256").to_bytes(),
    b"\x01\x00",
  )
  assert_eq(
    @types.CqlVarInt::from_bytes(b"\x01\x00").to_decimal_string(),
    "256",
  )
  assert_eq(
    @types.CqlVarInt::from_decimal_string("-256").to_bytes(),
    b"\xff\x00",
  )
  assert_eq(
    @types.CqlVarInt::from_bytes(b"\xff\x00").to_decimal_string(),
    "-256",
  )
  assert_eq(
    @types.CqlVarInt::from_decimal_string("9223372036854775808").to_bytes(),
