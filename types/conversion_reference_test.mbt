// 本文件由 scripts/conversion_reference.py 生成；使用 Python int、calendar、uuid 独立核对。

///|
test "Python proleptic Gregorian date reference" {
  assert_eq(
    @types.CqlDate::from_days(-2147483648).to_string(),
    "-5877641-06-23",
  )
  assert_eq(@types.CqlDate::from_string("-5877641-06-23").days(), -2147483648)
  assert_eq(@types.CqlDate::from_days(2147483647).to_string(), "+5881580-07-11")
  assert_eq(@types.CqlDate::from_string("+5881580-07-11").days(), 2147483647)
  assert_eq(@types.CqlDate::from_days(0).to_string(), "1970-01-01")
  assert_eq(@types.CqlDate::from_string("1970-01-01").days(), 0)
  assert_eq(@types.CqlDate::from_days(-1).to_string(), "1969-12-31")
  assert_eq(@types.CqlDate::from_string("1969-12-31").days(), -1)
  assert_eq(@types.CqlDate::from_days(11016).to_string(), "2000-02-29")
  assert_eq(@types.CqlDate::from_string("2000-02-29").days(), 11016)
  assert_eq(@types.CqlDate::from_days(-719528).to_string(), "0000-01-01")
  assert_eq(@types.CqlDate::from_string("0000-01-01").days(), -719528)
  assert_eq(@types.CqlDate::from_days(-719529).to_string(), "-000001-12-31")
  assert_eq(@types.CqlDate::from_string("-000001-12-31").days(), -719529)
