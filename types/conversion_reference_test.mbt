  let value_46 = @types.CqlDecimal::from_parts(
    68, b"\xff\x16\x9a\xca\x70\x2b\x9c\x5f\x9d\x84\x7a\xf0\xa1\xb7\x3c\x02\xab\x30\xd2\x35\x39\x41\x9a\x0f\x60\xc5",
