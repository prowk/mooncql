  let value_47 = @types.CqlDecimal::from_parts(
    24, b"\x00\xe2\x76\x49\x4c\x18\x50\xba\xd0\xcc\xa0\xd6\xde\x15\xb0\x51\x69\x52\x72\xbe\x16\xec\x1a\x99\x80\x06",
