    ),
    1290446055213868950L,
  )
  assert_eq(@routing.murmur3_token(b"\xff"), -4442228696663692417L)
  assert_eq(@routing.murmur3_token(b"\x80"), -5284281814142962636L)
  assert_eq(@routing.murmur3_token(b"\x80\x01"), 402482646042468656L)
  assert_eq(
    @routing.murmur3_token(b"\x68\x65\x6c\x6c\x6f"),
    -3758069500696749310L,
  )
  assert_eq(@routing.murmur3_token(b"\xe6\x9c\x88"), -525815160115121594L)
}

///|
test "single and composite routing keys match independently bound statement" {
  let values : Array[@types.Value] = [
    Integer(7),
    Text("月"),
    Bytes(b"\x80\xff"),
  ]
  let key = @routing.routing_key(values, [0]).unwrap()
  assert_eq(key, b"\x00\x00\x00\x07")
  assert_eq(@routing.murmur3_token(key), 1634052884888577606L)
  let key = @routing.routing_key(values, [1]).unwrap()
  assert_eq(key, b"\xe6\x9c\x88")
  assert_eq(@routing.murmur3_token(key), -525815160115121594L)
  let key = @routing.routing_key(values, [1, 0]).unwrap()
  assert_eq(key, b"\x00\x03\xe6\x9c\x88\x00\x00\x04\x00\x00\x00\x07\x00")
  assert_eq(@routing.murmur3_token(key), -8212754777484881858L)
  let key = @routing.routing_key(values, [2, 1, 0]).unwrap()
  assert_eq(
    key, b"\x00\x02\x80\xff\x00\x00\x03\xe6\x9c\x88\x00\x00\x04\x00\x00\x00\x07\x00",
  )
  assert_eq(@routing.murmur3_token(key), 2230084473087468231L)
  assert_true(@routing.routing_key(values, []) is None)
  assert_true(@routing.routing_key(values, [3]) is None)
  assert_true(@routing.routing_key(values, [1, 1]) is None)
  assert_true(@routing.routing_key([@types.Value::Null], [0]) is None)
  assert_true(@routing.routing_key([@types.Value::Unset], [0]) is None)
}
