///|
// 字节样例来自标准库独立生成器 scripts/protocol_reference.py，对齐固定 Event.java。
test "pinned independent event vectors cover all changes targets and inet widths" {
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0f\x54\x4f\x50\x4f\x4c\x4f\x47\x59\x5f\x43\x48\x41\x4e\x47\x45\x00\x08\x4e\x45\x57\x5f\x4e\x4f\x44\x45\x04\x7f\x00\x00\x02\x00\x00\x4a\x62",
    ),
    @protocol.ServerEvent::Topology(NewNode, {
      address: b"\x7f\x00\x00\x02",
      port: 19042,
    }),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0f\x54\x4f\x50\x4f\x4c\x4f\x47\x59\x5f\x43\x48\x41\x4e\x47\x45\x00\x08\x4e\x45\x57\x5f\x4e\x4f\x44\x45\x10\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x4a\x62",
    ),
    @protocol.ServerEvent::Topology(NewNode, {
      address: b"\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01",
      port: 19042,
    }),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0f\x54\x4f\x50\x4f\x4c\x4f\x47\x59\x5f\x43\x48\x41\x4e\x47\x45\x00\x0c\x52\x45\x4d\x4f\x56\x45\x44\x5f\x4e\x4f\x44\x45\x04\x7f\x00\x00\x02\x00\x00\x4a\x62",
    ),
    @protocol.ServerEvent::Topology(RemovedNode, {
      address: b"\x7f\x00\x00\x02",
      port: 19042,
    }),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0f\x54\x4f\x50\x4f\x4c\x4f\x47\x59\x5f\x43\x48\x41\x4e\x47\x45\x00\x0c\x52\x45\x4d\x4f\x56\x45\x44\x5f\x4e\x4f\x44\x45\x10\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x4a\x62",
    ),
    @protocol.ServerEvent::Topology(RemovedNode, {
      address: b"\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01",
      port: 19042,
    }),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0f\x54\x4f\x50\x4f\x4c\x4f\x47\x59\x5f\x43\x48\x41\x4e\x47\x45\x00\x0a\x4d\x4f\x56\x45\x44\x5f\x4e\x4f\x44\x45\x04\x7f\x00\x00\x02\x00\x00\x4a\x62",
    ),
    @protocol.ServerEvent::Topology(MovedNode, {
      address: b"\x7f\x00\x00\x02",
      port: 19042,
    }),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0f\x54\x4f\x50\x4f\x4c\x4f\x47\x59\x5f\x43\x48\x41\x4e\x47\x45\x00\x0a\x4d\x4f\x56\x45\x44\x5f\x4e\x4f\x44\x45\x10\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x4a\x62",
    ),
    @protocol.ServerEvent::Topology(MovedNode, {
      address: b"\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01",
      port: 19042,
    }),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x54\x41\x54\x55\x53\x5f\x43\x48\x41\x4e\x47\x45\x00\x02\x55\x50\x04\x7f\x00\x00\x02\x00\x00\x4a\x62",
    ),
    @protocol.ServerEvent::Status(Up, {
      address: b"\x7f\x00\x00\x02",
      port: 19042,
    }),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x54\x41\x54\x55\x53\x5f\x43\x48\x41\x4e\x47\x45\x00\x02\x55\x50\x10\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x4a\x62",
    ),
    @protocol.ServerEvent::Status(Up, {
      address: b"\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01",
      port: 19042,
    }),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x54\x41\x54\x55\x53\x5f\x43\x48\x41\x4e\x47\x45\x00\x04\x44\x4f\x57\x4e\x04\x7f\x00\x00\x02\x00\x00\x4a\x62",
    ),
    @protocol.ServerEvent::Status(Down, {
      address: b"\x7f\x00\x00\x02",
      port: 19042,
    }),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x54\x41\x54\x55\x53\x5f\x43\x48\x41\x4e\x47\x45\x00\x04\x44\x4f\x57\x4e\x10\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x4a\x62",
    ),
    @protocol.ServerEvent::Status(Down, {
      address: b"\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01",
      port: 19042,
    }),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x43\x52\x45\x41\x54\x45\x44\x00\x08\x4b\x45\x59\x53\x50\x41\x43\x45\x00\x02\x6b\x73",
    ),
    @protocol.ServerEvent::Schema(Created, Keyspace("ks")),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x43\x52\x45\x41\x54\x45\x44\x00\x05\x54\x41\x42\x4c\x45\x00\x02\x6b\x73\x00\x06\x6f\x62\x6a\x65\x63\x74",
    ),
    @protocol.ServerEvent::Schema(Created, Table("ks", "object")),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x43\x52\x45\x41\x54\x45\x44\x00\x04\x54\x59\x50\x45\x00\x02\x6b\x73\x00\x06\x6f\x62\x6a\x65\x63\x74",
    ),
    @protocol.ServerEvent::Schema(Created, Type("ks", "object")),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x43\x52\x45\x41\x54\x45\x44\x00\x08\x46\x55\x4e\x43\x54\x49\x4f\x4e\x00\x02\x6b\x73\x00\x06\x6f\x62\x6a\x65\x63\x74\x00\x02\x00\x03\x69\x6e\x74\x00\x12\x66\x72\x6f\x7a\x65\x6e\x3c\x6c\x69\x73\x74\x3c\x74\x65\x78\x74\x3e\x3e",
    ),
    @protocol.ServerEvent::Schema(
      Created,
      Function("ks", "object", ["int", "frozen<list<text>>"]),
    ),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x43\x52\x45\x41\x54\x45\x44\x00\x09\x41\x47\x47\x52\x45\x47\x41\x54\x45\x00\x02\x6b\x73\x00\x06\x6f\x62\x6a\x65\x63\x74\x00\x02\x00\x03\x69\x6e\x74\x00\x12\x66\x72\x6f\x7a\x65\x6e\x3c\x6c\x69\x73\x74\x3c\x74\x65\x78\x74\x3e\x3e",
    ),
    @protocol.ServerEvent::Schema(
      Created,
      Aggregate("ks", "object", ["int", "frozen<list<text>>"]),
    ),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x55\x50\x44\x41\x54\x45\x44\x00\x08\x4b\x45\x59\x53\x50\x41\x43\x45\x00\x02\x6b\x73",
    ),
    @protocol.ServerEvent::Schema(Updated, Keyspace("ks")),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x55\x50\x44\x41\x54\x45\x44\x00\x05\x54\x41\x42\x4c\x45\x00\x02\x6b\x73\x00\x06\x6f\x62\x6a\x65\x63\x74",
    ),
    @protocol.ServerEvent::Schema(Updated, Table("ks", "object")),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x55\x50\x44\x41\x54\x45\x44\x00\x04\x54\x59\x50\x45\x00\x02\x6b\x73\x00\x06\x6f\x62\x6a\x65\x63\x74",
    ),
    @protocol.ServerEvent::Schema(Updated, Type("ks", "object")),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x55\x50\x44\x41\x54\x45\x44\x00\x08\x46\x55\x4e\x43\x54\x49\x4f\x4e\x00\x02\x6b\x73\x00\x06\x6f\x62\x6a\x65\x63\x74\x00\x02\x00\x03\x69\x6e\x74\x00\x12\x66\x72\x6f\x7a\x65\x6e\x3c\x6c\x69\x73\x74\x3c\x74\x65\x78\x74\x3e\x3e",
    ),
    @protocol.ServerEvent::Schema(
      Updated,
      Function("ks", "object", ["int", "frozen<list<text>>"]),
    ),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x55\x50\x44\x41\x54\x45\x44\x00\x09\x41\x47\x47\x52\x45\x47\x41\x54\x45\x00\x02\x6b\x73\x00\x06\x6f\x62\x6a\x65\x63\x74\x00\x02\x00\x03\x69\x6e\x74\x00\x12\x66\x72\x6f\x7a\x65\x6e\x3c\x6c\x69\x73\x74\x3c\x74\x65\x78\x74\x3e\x3e",
    ),
    @protocol.ServerEvent::Schema(
      Updated,
      Aggregate("ks", "object", ["int", "frozen<list<text>>"]),
    ),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x44\x52\x4f\x50\x50\x45\x44\x00\x08\x4b\x45\x59\x53\x50\x41\x43\x45\x00\x02\x6b\x73",
    ),
    @protocol.ServerEvent::Schema(Dropped, Keyspace("ks")),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x44\x52\x4f\x50\x50\x45\x44\x00\x05\x54\x41\x42\x4c\x45\x00\x02\x6b\x73\x00\x06\x6f\x62\x6a\x65\x63\x74",
    ),
    @protocol.ServerEvent::Schema(Dropped, Table("ks", "object")),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x44\x52\x4f\x50\x50\x45\x44\x00\x04\x54\x59\x50\x45\x00\x02\x6b\x73\x00\x06\x6f\x62\x6a\x65\x63\x74",
    ),
    @protocol.ServerEvent::Schema(Dropped, Type("ks", "object")),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x44\x52\x4f\x50\x50\x45\x44\x00\x08\x46\x55\x4e\x43\x54\x49\x4f\x4e\x00\x02\x6b\x73\x00\x06\x6f\x62\x6a\x65\x63\x74\x00\x02\x00\x03\x69\x6e\x74\x00\x12\x66\x72\x6f\x7a\x65\x6e\x3c\x6c\x69\x73\x74\x3c\x74\x65\x78\x74\x3e\x3e",
    ),
    @protocol.ServerEvent::Schema(
      Dropped,
      Function("ks", "object", ["int", "frozen<list<text>>"]),
    ),
  )
  assert_eq(
    @protocol.decode_event(
      b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x44\x52\x4f\x50\x50\x45\x44\x00\x09\x41\x47\x47\x52\x45\x47\x41\x54\x45\x00\x02\x6b\x73\x00\x06\x6f\x62\x6a\x65\x63\x74\x00\x02\x00\x03\x69\x6e\x74\x00\x12\x66\x72\x6f\x7a\x65\x6e\x3c\x6c\x69\x73\x74\x3c\x74\x65\x78\x74\x3e\x3e",
    ),
    @protocol.ServerEvent::Schema(
      Dropped,
      Aggregate("ks", "object", ["int", "frozen<list<text>>"]),
