}

///|
test "event truncation trailing data invalid enums and inet cannot be accepted" {
  let valid = b"\x00\x0f\x54\x4f\x50\x4f\x4c\x4f\x47\x59\x5f\x43\x48\x41\x4e\x47\x45\x00\x08\x4e\x45\x57\x5f\x4e\x4f\x44\x45\x04\x7f\x00\x00\x02\x00\x00\x4a\x62"
  for size in 0..<valid.length() {
    assert_true(
      try {
        ignore(@protocol.decode_event(valid[:size].to_owned()))
        false
      } catch {
        _ => true
      },
    )
  }
  let invalid = [
    b"\x00\x0d\x53\x54\x41\x54\x55\x53\x5f\x43\x48\x41\x4e\x47\x45\x00\x02\x55\x50\x04\x7f\x00\x00\x02\x00\x00\x4a\x62\x58",
    b"\x00\x0d\x53\x54\x41\x54\x55\x53\x5f\x43\x48\x41\x4e\x47\x45\x00\x02\x58\x58\x04\x7f\x00\x00\x02\x00\x00\x4a\x62",
    b"\x00\x0d\x53\x54\x41\x54\x55\x53\x5f\x43\x48\x41\x4e\x47\x45\x00\x02\x55\x50\x04\x7f\x00\x00\x02\x00\x01\x00\x00",
    b"\x00\x0d\x53\x54\x41\x54\x55\x53\x5f\x43\x48\x41\x4e\x47\x45\x00\x02\x55\x50\x04\x7f\x00\x00\x02\xff\xff\xff\xff",
    b"\x00\x0d\x53\x54\x41\x54\x55\x53\x5f\x43\x48\x41\x4e\x47\x45\x00\x02\x55\x50\x03\x7f\x00\x02\x00\x00\x4a\x62",
    b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x55\x4e\x4b\x4e\x4f\x57\x4e\x00\x05\x54\x41\x42\x4c\x45\x00\x02\x6b\x73\x00\x06\x6f\x62\x6a\x65\x63\x74",
    b"\x00\x0d\x53\x43\x48\x45\x4d\x41\x5f\x43\x48\x41\x4e\x47\x45\x00\x07\x43\x52\x45\x41\x54\x45\x44\x00\x05\x4f\x54\x48\x45\x52\x00\x02\x6b\x73\x00\x06\x6f\x62\x6a\x65\x63\x74",
  ]
  for body in invalid {
    assert_true(
      try {
        ignore(@protocol.decode_event(body))
        false
      } catch {
        _ => true
      },
    )
  }
}

///|
test "REGISTER matches independent string list and rejects invalid subscriptions" {
  let request = @protocol.register([TopologyChange, StatusChange, SchemaChange])
  assert_eq(request.opcode, 11)
  assert_eq(
    request.body,
    b"\x00\x03\x00\x0fTOPOLOGY_CHANGE\x00\x0dSTATUS_CHANGE\x00\x0dSCHEMA_CHANGE",
  )
  for events in [[], [@protocol.EventKind::StatusChange, StatusChange]] {
    assert_true(
      try {
        ignore(@protocol.register(events))
        false
      } catch {
        _ => true
      },
    )
  }
}
